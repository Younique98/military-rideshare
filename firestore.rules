// ============================================================================
// Firestore Security Rules — Base Link (military-rideshare)
// ============================================================================
//
// What this protects:
//   - users/{userId}    Rider/driver profile documents (see
//                        src/utils/user.ts, src/lib/firebase/admin.ts).
//   - rides/{rideId}     Real ride requests/matches with a real status
//                        lifecycle — see src/types/ride.ts and
//                        src/lib/firebase/rides.ts. Ride creation itself is
//                        additionally gated behind NEXT_PUBLIC_PLATFORM_LAUNCHED
//                        in application code (src/lib/launch.ts) — these
//                        rules govern *who may touch which fields once a
//                        write is attempted*, not the pre-launch business
//                        gate, which Firestore rules cannot see (it's a
//                        server env var, not data).
//   - waitlist/{docId}   "Notify me" signups collected while the platform
//                        is not yet launched (see src/lib/firebase/waitlist.ts).
//
// Model: every document is owned by the authenticated user(s) named in it,
// nothing here is publicly readable or writable, and unauthenticated
// requests are denied. Every match block re-checks request.auth itself
// rather than relying on the catch-all default-deny alone.
//
// A second, equally important property of the rules below: several fields
// are never trusted from the client, no matter who is making the request —
//   - users/{uid}.stripeConnectedAccountId and .stripeOnboardingComplete are
//     only ever written by the Admin SDK (Stripe Connect onboarding route /
//     webhook — see src/app/api/stripe/**), which bypasses these rules
//     entirely. The rules below actively block the *client* from setting or
//     changing either field, so a user can never grant themselves driver
//     payout eligibility by editing their own profile document.
//   - rides/{rideId}.fare, .riderId, .pickup, .dropoff, .requestedAt and
//     .payment are immutable from the client after creation. Only the
//     Admin SDK (via the Stripe payment routes / webhook) may write
//     .payment or move a ride into 'PAID' — the rules below never allow a
//     client update to reach that status.
//
// Deploying these rules: this repo has no Firebase CLI project link
// (.firebaserc) checked in, and these rules are committed but NOT deployed
// by this PR. To make them take effect, either paste this file's contents
// into the Firebase console (Firestore Database > Rules) for the project
// backing NEXT_PUBLIC_FIREBASE_PROJECT_ID, or, once authenticated against
// the real project, run:
//   firebase deploy --only firestore:rules,storage:rules
// (firebase.json in this repo already points the CLI at this file and at
// storage.rules).
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An "eligible driver" for reading the open-ride queue and accepting a
    // ride is one whose Stripe Connect onboarding has actually completed —
    // a fact only the Stripe webhook can set (see users/{userId} below).
    // This intentionally ties ride-matching eligibility to "this driver can
    // actually be paid", rather than a self-declared role field.
    function isOnboardedDriver(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('stripeOnboardingComplete', false) == true;
    }

    // --- users/{userId} ----------------------------------------------
    // One profile document per account, keyed by the Firebase Auth uid.
    // A user may only read their own profile — never another rider's or
    // driver's name, photo, or verification status.
    match /users/{userId} {
      allow read: if request.auth != null
                   && request.auth.uid == userId;

      // A user may create their own profile document, but not with Stripe
      // payout eligibility already turned on — that can only come from a
      // real completed Stripe Connect onboarding, recorded server-side.
      allow create: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.get('stripeOnboardingComplete', false) == false
                     && request.resource.data.get('stripeConnectedAccountId', null) == null;

      // A user may update their own profile, but stripeConnectedAccountId
      // and stripeOnboardingComplete must be left exactly as they were —
      // only the Stripe Connect onboarding route / webhook (Admin SDK,
      // which bypasses these rules) may change them.
      allow update: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.get('stripeConnectedAccountId', null) == resource.data.get('stripeConnectedAccountId', null)
                     && request.resource.data.get('stripeOnboardingComplete', false) == resource.data.get('stripeOnboardingComplete', false);

      allow delete: if false;
    }

    // --- rides/{rideId} -------------------------------------------------
    // Status lifecycle: REQUESTED -> ACCEPTED -> IN_PROGRESS -> COMPLETED
    // -> PAID, or CANCELLED out of REQUESTED/ACCEPTED. See src/types/ride.ts.
    match /rides/{rideId} {

      // Visible to: the rider who requested it, the driver assigned to it
      // once matched, and — only while still REQUESTED and driverless — any
      // onboarded driver browsing the open-ride queue.
      //
      // Every field read below uses .get(field, default) rather than direct
      // dot access (resource.data.riderId). This isn't defensive styling —
      // it's required: for a *list* request (a query, like the driver's
      // open-ride queue subscription — not a single-document get()),
      // Firestore's rule evaluator checks whether this OR condition can
      // hold without necessarily having concrete per-document data bound
      // for every branch, and direct dot access throws "Property riderId
      // is undefined on object" in that mode — confirmed against a real
      // Firestore emulator running exactly the driver's query in
      // src/lib/firebase/rides.ts's subscribeToRequestedRides(). Every
      // field here always exists on a real ride document, so the defaults
      // below never change what's actually allowed, only how the
      // condition is safely evaluated at list time.
      allow read: if request.auth != null
                   && (resource.data.get('riderId', null) == request.auth.uid
                       || resource.data.get('driverId', null) == request.auth.uid
                       || (resource.data.get('status', null) == 'REQUESTED'
                           && resource.data.get('driverId', null) == null
                           && isOnboardedDriver(request.auth.uid)));

      // A rider may only ever create a ride as themselves, in the
      // REQUESTED state, with no driver and no payment data attached yet.
      // (Whether ride creation is allowed AT ALL right now is a separate,
      // application-level gate — see NEXT_PUBLIC_PLATFORM_LAUNCHED in
      // src/lib/launch.ts / src/lib/firebase/rides.ts — Firestore rules
      // have no visibility into that server env var.)
      allow create: if request.auth != null
                     && request.resource.data.riderId == request.auth.uid
                     && request.resource.data.status == 'REQUESTED'
                     && request.resource.data.driverId == null
                     && request.resource.data.fare is number
                     && request.resource.data.fare > 0
                     && request.resource.data.pickup is map
                     && request.resource.data.dropoff is map
                     && !('payment' in request.resource.data);

      // Every update path below requires the rider, pickup/dropoff, fare,
      // requestedAt and payment fields to be byte-for-byte unchanged — none
      // of those may ever be altered by a client-side update, regardless of
      // which transition is being made.
      allow update: if request.auth != null
                     && request.resource.data.riderId == resource.data.riderId
                     && request.resource.data.pickup == resource.data.pickup
                     && request.resource.data.dropoff == resource.data.dropoff
                     && request.resource.data.fare == resource.data.fare
                     && request.resource.data.requestedAt == resource.data.requestedAt
                     && request.resource.data.get('payment', null) == resource.data.get('payment', null)
                     && (
                       // An onboarded driver claims a still-open ride.
                       (resource.data.status == 'REQUESTED'
                         && resource.data.driverId == null
                         && request.resource.data.status == 'ACCEPTED'
                         && request.resource.data.driverId == request.auth.uid
                         && isOnboardedDriver(request.auth.uid))

                       // The already-assigned driver advances their own ride
                       // one step at a time. driverId itself never changes
                       // here.
                       || (resource.data.driverId == request.auth.uid
                           && request.resource.data.driverId == resource.data.driverId
                           && (
                             (resource.data.status == 'ACCEPTED' && request.resource.data.status == 'IN_PROGRESS')
                             || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'COMPLETED')
                           ))

                       // The rider or the assigned driver cancels before the
                       // ride is underway.
                       || ((resource.data.riderId == request.auth.uid || resource.data.driverId == request.auth.uid)
                           && resource.data.status in ['REQUESTED', 'ACCEPTED']
                           && request.resource.data.status == 'CANCELLED'
                           && request.resource.data.driverId == resource.data.driverId)
                     );
                     // Note: there is deliberately no client-reachable branch
                     // that produces status == 'PAID', and .payment can never
                     // be written by a client update (see the shared
                     // unchanged-field checks above) — both only ever happen
                     // via the Stripe webhook using the Admin SDK, which
                     // bypasses these rules. See src/app/api/stripe/webhook.

      // No client-side deletes — a ride should be cancelled via its status
      // field, not removed outright, so history/auditing isn't lost.
      allow delete: if false;
    }

    // --- waitlist/{docId} ------------------------------------------------
    // "Notify me when Base Link launches" signups collected while
    // NEXT_PUBLIC_PLATFORM_LAUNCHED is not "true" — see
    // src/lib/firebase/waitlist.ts. Write-only from the client's
    // perspective: a signup can be created and then never read back,
    // changed, or deleted by the person who submitted it (or anyone else).
    match /waitlist/{docId} {
      allow create: if request.auth != null
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.email is string
                     && request.resource.data.email.size() > 0;
      allow read, update, delete: if false;
    }

    // --- default deny ----------------------------------------------------
    // Anything not explicitly matched above (and any unauthenticated
    // request) is denied. This is a safety net, not the primary control —
    // every match block above already re-checks request.auth itself.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
