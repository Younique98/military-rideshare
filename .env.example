# Copy this file to .env.local and fill in real values for local
# development. .env.local is git-ignored and must never be committed.

# App Configuration
NEXT_PUBLIC_APP_NAME=Base Link
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web SDK config (public by design — see src/lib/firebase/config.ts
# for why these are safe to ship to the client; access control lives in
# firestore.rules / storage.rules, not in keeping these values secret)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Demo mode — DO NOT set this to "true" in production.
#
# There is no real ID.me OAuth integration wired up in this codebase yet
# (no client secret, no server-side token exchange, no verified-status
# check). When this flag is unset/false (the default), the "Verify with
# ID.me" button is disabled and shows an honest "not yet connected"
# message instead of granting a fake verified badge. Set it to "true"
# only in a local/demo/portfolio environment to enable a clearly-labeled
# mock verification flow — every screen reachable through it is marked
# "DEMO — not a real verification".
NEXT_PUBLIC_DEMO_MODE=false

# ============================================================================
# Pre-launch gate — DO NOT set this to "true" until Erica has a
# Transportation Network Company (TNC) license and insurance in place for
# whatever state Base Link is launching in. Most US states require this
# before a ride-matching-for-pay service can operate for real, paying
# users (Virginia's license alone runs $100K+; other states are cheaper or
# free but still require insurance).
#
# The real ride-booking and Stripe Connect payment code is fully built
# (see src/lib/firebase/rides.ts and src/app/api/stripe/**) and can be
# exercised in a local/dev/test environment by setting this to "true"
# there — it stays unset/false in every real deployment until the
# licensing/insurance is actually sorted. This fails closed: only the
# exact string "true" enables it — see src/lib/launch.ts.
#
# While false (the default): the ride-request UI shows a clear pre-launch
# banner, "Request a Ride" routes to a waitlist signup instead of creating
# a real ride, and both the ride-creation code path and the Stripe
# PaymentIntent route independently refuse to run for real.
NEXT_PUBLIC_PLATFORM_LAUNCHED=false

# ============================================================================
# Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_, never
# commit a real value)
#
# Full service account JSON key for the same project as
# NEXT_PUBLIC_FIREBASE_PROJECT_ID above, minified to one line. Used by the
# Stripe API routes (src/app/api/stripe/**) to verify signed-in users
# server-side and to write the handful of fields firestore.rules
# deliberately keeps the client from setting itself (Stripe Connect
# account id/onboarding status, ride payment status, the PAID ride status).
# Generate one at: Firebase Console > Project Settings > Service Accounts >
# Generate New Private Key.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ============================================================================
# Stripe Connect (marketplace payments) — SERVER ONLY except where noted.
#
# Rider payments are split automatically between Base Link and the driver
# via Stripe Connect destination charges (application_fee_amount +
# transfer_data.destination) — see src/lib/stripe/server.ts for the
# platform fee percentage and src/app/api/stripe/** for the routes.
#
# Secret key for your Stripe account (test mode key while developing —
# starts with sk_test_; never a live sk_live_ key until real launch).
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (src/app/api/stripe/webhook) —
# from the Stripe Dashboard's webhook settings, or `stripe listen` for
# local testing.
STRIPE_WEBHOOK_SECRET=

# Only needed if you later add a Standard-account OAuth Connect flow
# instead of the Express + Stripe-hosted Account Links flow this app
# currently uses (accountLinks.create doesn't require it). Safe to leave
# blank for now.
STRIPE_CONNECT_CLIENT_ID=
